# ==============================================================================
# BHARAT MAKAAN ENTERPRISE — ENVIRONMENT TEMPLATE
# Copy to apps/web/.env.local, apps/mobile/.env.local, and functions/.env
# NEVER expose backend secrets in VITE_* or EXPO_PUBLIC_* frontend variables!
# ==============================================================================

# --- Public Client Firebase Config (Safe for Web & Mobile) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=bharat-makaan-prod
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_FIREBASE_EMULATORS=false
VITE_PUBLIC_APP_URL=https://bharatmakaan.com
VITE_GOOGLE_MAPS_API_KEY=
VITE_RAZORPAY_PUBLIC_KEY_ID=

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=bharat-makaan-prod
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
# Google OAuth client IDs from the same Google Cloud project as Firebase.
# Mobile Google sign-in requires a native development/production build, not Expo Go.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# --- Server-Only Backend Secrets (Cloud Functions / Secret Manager ONLY) ---
OPENAI_API_KEY=
OPENAI_MODEL_PRIMARY=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=

GOOGLE_ADS_DEFAULT_WEBHOOK_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_SAAS_WEBHOOK_SECRET=

EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Bharat Makaan <no-reply@bharatmakaan.com>"

# --- Initial Super Admin Bootstrap (scripts/provision-super-admin.ts ONLY) ---
