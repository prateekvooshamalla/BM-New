{
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "functions": [
    {
      "source": ".firebase/functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "pnpm --filter @bharat-makaan/config build",
        "pnpm --filter @bharat-makaan/shared build",
        "pnpm --filter @bharat-makaan/validation build",
        "pnpm --filter @bharat-makaan/functions build",
        "node scripts/prepare-functions-deploy.mjs",
        "npm --prefix .firebase/functions install --omit dev --ignore-scripts"
      ]
    }
  ],
  "hosting": {
    "public": "apps/web/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/webhooks/whatsapp",
        "function": "whatsappWebhook"
      },
      {
        "source": "/api/webhooks/meta-leads",
        "function": "metaLeadsWebhook"
      },
      {
        "source": "/api/webhooks/google-ads",
        "function": "googleAdsWebhook"
      },
      {
        "source": "/api/webhooks/razorpay-collections",
        "function": "razorpayCollectionsWebhook"
      },
      {
        "source": "/api/webhooks/razorpay-saas",
        "function": "razorpaySaasWebhook"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      }
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
