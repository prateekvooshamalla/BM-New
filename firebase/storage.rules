rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn()
        && request.auth.token.get('platformRole', '') == 'PLATFORM_SUPER_ADMIN';
    }

    function orgDoc(orgId) {
      return firestore.get(/databases/(default)/documents/organizations/$(orgId));
    }

    function isOrgActive(orgId) {
      return orgDoc(orgId).data != null && orgDoc(orgId).data.status == 'ACTIVE';
    }

    function memberDoc(orgId) {
      return firestore.get(/databases/(default)/documents/organization_members/$(orgId + '_' + request.auth.uid));
    }

    function hasOrgStoragePermission(orgId, perm) {
      return isSuperAdmin()
        || (
          isSignedIn()
          && isOrgActive(orgId)
          && memberDoc(orgId).data != null
          && memberDoc(orgId).data.status == 'ACTIVE'
          && perm in memberDoc(orgId).data.permissions
        );
    }

    function projectDoc(orgId, projectId) {
      return firestore.get(/databases/(default)/documents/projects/$(projectId)).data.orgId == orgId;
    }

    function hasProjectStoragePermission(orgId, projectId, perm) {
      return projectDoc(orgId, projectId)
        && (
          isSuperAdmin()
          || (
            isSignedIn()
            && isOrgActive(orgId)
            && memberDoc(orgId).data != null
            && memberDoc(orgId).data.status == 'ACTIVE'
            && perm in memberDoc(orgId).data.permissions
            && (
              memberDoc(orgId).data.role in ['BUILDER_ADMIN', 'PROJECT_DIRECTOR']
              || memberDoc(orgId).data.get('assignedProjectIds', []).size() == 0
              || projectId in memberDoc(orgId).data.get('assignedProjectIds', [])
            )
          )
        );
    }

    function isAllowedContentType() {
      return request.resource.contentType.matches('application/pdf')
        || request.resource.contentType.matches('image/png')
        || request.resource.contentType.matches('image/jpeg')
        || request.resource.contentType.matches('image/webp');
    }

    function isWithinSizeLimit() {
      return request.resource.size <= 25 * 1024 * 1024;
    }

    // Approved public listing media
    match /public-listings/{orgId}/{projectId}/{allPaths=**} {
      allow read: if true;
      allow write: if hasOrgStoragePermission(orgId, 'documents:upload')
        && isAllowedContentType()
        && isWithinSizeLimit();
    }

    // AI floor-plan uploads are limited to users authorized for that project.
    match /organizations/{orgId}/projects/{projectId}/ai-floorplans/{allPaths=**} {
      allow write: if hasProjectStoragePermission(orgId, projectId, 'ai:use')
        && isAllowedContentType()
        && isWithinSizeLimit();
    }

    // Multi-tenant organization private repository
    match /organizations/{orgId}/{allPaths=**} {
      allow read: if hasOrgStoragePermission(orgId, 'documents:view');
      allow write: if hasOrgStoragePermission(orgId, 'documents:upload')
        && isAllowedContentType()
        && isWithinSizeLimit();
    }

    // Default deny all other paths
    match /{allOtherPaths=**} {
      allow read, write: if false;
    }
  }
}
